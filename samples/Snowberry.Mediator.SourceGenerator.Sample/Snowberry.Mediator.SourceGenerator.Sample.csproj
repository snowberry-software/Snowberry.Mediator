<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>

		<!-- Native AOT smoke test: the generated registration path must produce zero trim/AOT warnings. -->
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- Run the trim/AOT/single-file analyzers on build so warnings surface without the native toolchain. -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snowberry.Mediator.SourceGenerator.Sample.Handlers\Snowberry.Mediator.SourceGenerator.Sample.Handlers.csproj" />
		<ProjectReference Include="..\..\src\Snowberry.Mediator\Snowberry.Mediator.csproj" />
		<ProjectReference Include="..\..\src\Snowberry.Mediator.Abstractions\Snowberry.Mediator.Abstractions.csproj" />
		<ProjectReference Include="..\..\src\Snowberry.Mediator.Extensions.DependencyInjection\Snowberry.Mediator.Extensions.DependencyInjection.csproj" />
		<ProjectReference Include="..\..\src\Snowberry.Mediator.SourceGenerator\Snowberry.Mediator.SourceGenerator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
