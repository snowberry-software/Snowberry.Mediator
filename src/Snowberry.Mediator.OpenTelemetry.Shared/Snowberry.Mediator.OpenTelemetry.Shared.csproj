<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;netstandard2.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Snowberry.Mediator.OpenTelemetry</RootNamespace>

		<!-- Package -->
		<Description>Core OpenTelemetry tracing and metrics decorator for Snowberry.Mediator (container-agnostic).</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="$(TargetFramework) != 'netstandard2.0'">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snowberry.Mediator\Snowberry.Mediator.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Snowberry.Mediator.Tests, " />
		<InternalsVisibleTo Include="Snowberry.Mediator.Benchmarks, " />
		<InternalsVisibleTo Include="Snowberry.Mediator.Extensions.OpenTelemetry, " />
		<InternalsVisibleTo Include="Snowberry.Mediator.OpenTelemetry, " />
	</ItemGroup>

	<Import Project="../NuGetPackage.props" />
	<Import Project="../PolySharp.props" />
</Project>
