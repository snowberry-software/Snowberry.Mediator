<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0;net10.0;netstandard2.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Package -->
		<Description>A tiny mediator for clean, decoupled application flow.</Description>

		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework) != 'netstandard2.0'">
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- ActivitySource ships in-box on .NET 6+; on netstandard2.0 it requires the standalone package. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Snowberry.Mediator.Abstractions\Snowberry.Mediator.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- PublicKey extracted from src/Snowberry.Mediator.snk via `sn -p ... key` then `sn -tp key`.
		     All projects under src/ are strong-signed via Directory.Build.props using the same key. -->
		<InternalsVisibleTo Include="Snowberry.Mediator.Tests, " />
		<InternalsVisibleTo Include="Snowberry.Mediator.Benchmarks, " />
	</ItemGroup>

	<Import Project="../NuGetPackage.props" />
	<Import Project="../PolySharp.props" />

	<!-- Generates MediatorDiagnostics.c_InstrumentationVersion from $(Version), so the OpenTelemetry
	     instrumentation-scope version emitted on spans and metrics always matches the package version. -->
	<Target Name="GenerateInstrumentationVersion" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<_InstrumentationVersionFile>$(IntermediateOutputPath)MediatorDiagnostics.Version.g.cs</_InstrumentationVersionFile>
			<_InstrumentationVersionSource><![CDATA[// <auto-generated/>
namespace Snowberry.Mediator
{
    partial class MediatorDiagnostics
    {
        /// <summary>
        /// The instrumentation-scope version stamped onto the per-step <see cref="System.Diagnostics.ActivitySource"/> instances, so
        /// emitted spans carry the library version (OpenTelemetry instrumentation-scope convention). Generated from the package version at build time.
        /// </summary>
        public const string c_InstrumentationVersion = "$(Version)"%3B
    }
}
]]></_InstrumentationVersionSource>
		</PropertyGroup>
		<WriteLinesToFile File="$(_InstrumentationVersionFile)" Lines="$([MSBuild]::Escape($(_InstrumentationVersionSource)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(_InstrumentationVersionFile)" />
			<FileWrites Include="$(_InstrumentationVersionFile)" />
		</ItemGroup>
	</Target>
</Project>